# Required
JWT_SECRET=your_32_char_minimum_secret_here
DATABASE_URL=mysql://user:password@host:3306/editorial_ai
VITE_APP_ID=editorial-ai

# LLM — Use Groq (FREE at console.groq.com)
BUILT_IN_FORGE_API_URL=https://api.groq.com/openai
BUILT_IN_FORGE_API_KEY=your_groq_api_key

# Optional
OPENAI_API_KEY=               # for Whisper transcription (optional)
ELEVENLABS_API_KEY=           # for TTS (free tier: 10k chars/month)
OAUTH_SERVER_URL=             # if using external OAuth
NODE_ENV=development
PORT=3000
