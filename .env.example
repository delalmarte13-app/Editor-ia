# Never commit real keys. Use local environment variables or deployment secrets.
JWT_SECRET=your_32_char_minimum_secret_here
DATABASE_URL=mysql://user:password@host:3306/editorial_ai
VITE_APP_ID=editorial-ai
NODE_ENV=development
PORT=3000

# Existing Groq compatibility configuration
BUILT_IN_FORGE_API_URL=https://api.groq.com/openai
BUILT_IN_FORGE_API_KEY=

# Provider priority: local/free options first, paid fallback last
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-4b-it:free

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional paid fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional speech
ELEVENLABS_API_KEY=
OAUTH_SERVER_URL=
